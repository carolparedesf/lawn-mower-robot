# RViz2 para la simulacion (fake_robot + nav.launch.py). Abrir con:
#   rviz2 -d $(ros2 pkg prefix lawnbot_nav)/share/lawnbot_nav/config/sim.rviz
# o, desde el repo:  rviz2 -d ros2_ws/src/lawnbot_nav/config/sim.rviz
# Fixed Frame: map (fake_robot publica map -> base_footprint con sim_room.yaml).
Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 20
      Color: 70; 70; 70
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: false
      Show Axes: true
      Marker Scale: 0.5
    - Class: rviz_default_plugins/MarkerArray
      Name: Simulacion (/sim/markers)
      Enabled: true
      Namespaces: {}
      Topic:
        Value: /sim/markers
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
    - Class: rviz_default_plugins/Path
      Name: Rastro (/sim/path)
      Enabled: true
      Color: 80; 160; 255
      Line Style: Lines
      Line Width: 0.03
      Alpha: 1
      Pose Style: None
      Topic:
        Value: /sim/path
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
    - Class: rviz_default_plugins/Polygon
      Name: Cerco (/geofence/polygon)
      Enabled: true
      Color: 60; 220; 60
      Alpha: 1
      Topic:
        Value: /geofence/polygon
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
    - Class: rviz_default_plugins/MarkerArray
      Name: Cobertura (/coverage/markers)
      Enabled: true
      Namespaces: {}
      Topic:
        Value: /coverage/markers
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
  Global Options:
    Fixed Frame: map
    Frame Rate: 30
    Background Color: 30; 30; 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Vista cenital
      Scale: 60
      X: 5
      Y: 4
      Angle: 0
      Near Clip Distance: 0.01
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Width: 1300
