<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lawnbot_vision</name>
  <version>0.1.0</version>
  <description>Nodo de vision: publica /vision/grass_present y /vision/obstacles a partir del modelo de segmentacion.</description>
  <maintainer email="carolparedesf@fiuna.edu.py">carolparedesf</maintainer>
  <license>TODO: License declaration</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <!-- Fuera de rosdep: ncnn (con pip, opcion user, en el python del sistema que usa ROS). No usa ultralytics. -->

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
